# Copy to .env (git-ignored). Never commit real values.
# No secrets are required for the offline demo.

# Backend
API_HOST=127.0.0.1
API_PORT=8000

# Strict mode: turn unverified config constants into errors before the demo video.
# See architecture.md section 5.
STRICT_VERIFIED=0

# --- v4 two-option model -----------------------------------------------------

# mock | live. `mock` talks to the simulator on :8100. The app REFUSES TO START when
# APP_ENV=production and any adapter is simulated (golden rule 16).
PROVIDER_MODE=mock
APP_ENV=development

# Where the mock provider service (simulation only) listens. Nothing here is real.
MOCK_PROVIDERS_URL=http://127.0.0.1:8100

# Enables the simulated clock and POST /api/v1/mock/clock (never in production).
MOCK_CLOCK=0

# SQLite demo store. `make db-reset` recreates and seeds it. Money is TEXT.
DATABASE_URL=sqlite:///./data/samadhaan.db

# Webhook signing secrets, one per provider. Placeholders only: replace them in
# your local .env, never in the repo. A delivery with a bad or stale signature is
# rejected with 401 before the body is parsed.
WEBHOOK_SECRET_ESIGN=replace-me-local-only
WEBHOOK_SECRET_MARKETPLACE=replace-me-local-only
WEBHOOK_SECRET_DISBURSEMENT=replace-me-local-only
