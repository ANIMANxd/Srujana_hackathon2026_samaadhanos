{
  "name": "samaadhanos-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-contracts.mjs",
    "postinstall": "node scripts/sync-contracts.mjs",
    "predev": "node scripts/sync-contracts.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-contracts.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "node scripts/sync-contracts.mjs && next typegen",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
