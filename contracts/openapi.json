  "info": {
    "description": "MSME payment-rights evaluation API. Contract v1.0; frozen and additive-only after the contract-v1 tag (architecture.md section 9).",
    "title": "SamadhaanOS API",
    "version": "1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/config": {
      "get": {
        "description": "The statute config with its verified flags, for the assumptions drawer.\n\nReturns a labelled stub when statute_config.json is absent so the offline\ndemo still runs. No value here is treated as statutory by the API.",
        "operationId": "get_config_api_v1_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Config Api V1 Config Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Config"
      }
    },
    "/api/v1/evaluate-case": {
      "post": {
        "description": "Evaluate a case.\n\nPLACEHOLDER: the engine is not built yet, so this returns a fixed sample\nresponse flagged with a PLACEHOLDER_DATA warning. It evaluates nothing.",
        "operationId": "evaluate_case_api_v1_evaluate_case_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseEvaluationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseEvaluationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evaluate Case"
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Liveness plus config load status (section 8.1).",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/presets": {
      "get": {
        "description": "List preset ids and titles (input-only files; section 8.1).",
        "operationId": "list_presets_api_v1_presets_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List Presets Api V1 Presets Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Presets"
      }
    },
    "/api/v1/presets/{preset_id}": {
      "get": {
        "description": "Return a preset's request (input only). 404 if it does not exist.",
        "operationId": "get_preset_api_v1_presets__preset_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "preset_id",
            "required": true,
            "schema": {
              "title": "Preset Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Preset Api V1 Presets  Preset Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Preset"
      }
    }
  }
}
